# PostgreSQL connection string (update for your env)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cyphermed?schema=public"

# App
PORT=4000

# Signs the JWT access and refresh tokens. Required: the backend does not start without it.
# At least 32 characters, e.g. the output of: openssl rand -base64 32
JWT_SECRET=

# Frontend origins allowed in sign-in messages (SIWX), comma-separated.
# Default: http://localhost:3001 (the app in development)
# SIWX_ALLOWED_ORIGINS=https://cyphermed.vercel.app,https://app-three-rho-15.vercel.app

# For encryption integration (example)
KMS_ENDPOINT=
